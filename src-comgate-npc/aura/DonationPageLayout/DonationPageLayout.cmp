<aura:component description="DonationPageLayout" implements="forceCommunity:themeLayout,forceCommunity:layout">
    <aura:attribute name="header" type="Aura.Component[]" required="false"/>
    <aura:attribute name="bodyText" type="Aura.Component[]" required="false"/>
    <aura:attribute name="mainBody" type="Aura.Component[]" required="false"/>
    <aura:attribute name="form" type="Aura.Component[]" required="false"/>
    <aura:attribute name="footer" type="Aura.Component[]" required="false"/>
    <aura:attribute name="showDonateButton" type="Boolean" default="false"/>
    
    <aura:handler name="init" value="{!this}" action="{!c.doInit}"/>
    <aura:handler event="c:DonationPageScrollEvent" action="{!c.handleScrollEvent}"/>

    <ltng:require styles="{!$Resource.DonationPageCss}" />
    
    
    <div>
        <div>{!v.header}</div>
        <div class="content">
            <div class="donation-form" aura:id="donationForm">
                <div class="form-wrapper">
                    {!v.form}
                </div>
            </div>

            <div class="form-text container">
                <div>
                    {!v.bodyText}
                </div>
            </div>
        </div>

        <div>{!v.mainBody}</div>
        <div>{!v.footer}</div>
        
    </div>
</aura:component>