<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>64.0</apiVersion>
    <description>DKD legal pages - terms and conditions / privacy policy required by Comgate for card payment approval</description>
    <isExposed>true</isExposed>
    <masterLabel>Donation Page Legal</masterLabel>
    <targets>
        <target>lightningCommunity__Page</target>
        <target>lightningCommunity__Default</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightningCommunity__Default">
            <property name="document" type="String" label="Document"
                      description="Which document to render: 'terms' or 'privacy'" default="terms"/>
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>
