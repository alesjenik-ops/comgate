    <fields>
        <fullName>fpnpc_analytics__Amount__c</fullName>
        <deprecated>false</deprecated>
        <description>Expected recurring amount per installment. For automatic commitments = amount of the most recent gift transaction. For manual commitments this can be entered by hand and is preserved on recalculation. Auto-populated by DonorStatsCalculator for automatic commitments only.</description>
        <inlineHelpText>Expected recurring amount per installment.</inlineHelpText>
        <label>Amount</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>fpnpc_analytics__Analytics_Type__c</fullName>
        <deprecated>false</deprecated>
        <label>Analytics Type</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Automatic</fullName>
                    <default>false</default>
                    <label>Automatic</label>
                </value>
                <value>
                    <fullName>Manual</fullName>
                    <default>false</default>
                    <label>Manual</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>fpnpc_analytics__Darujme_Pledge__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <deprecated>false</deprecated>
        <description>Lookup to the Darujme Pledge this recurring donation originates from. Auto-populated by DonorStatsCalculator from the Darujme transactions assigned to this commitment.</description>
        <inlineHelpText>The Darujme Pledge this recurring donation originates from.</inlineHelpText>
        <label>Darujme Pledge</label>
        <referenceTo>CRMforNonProfit__Darujme_Pledge__c</referenceTo>
        <relationshipLabel>Gift Commitments</relationshipLabel>
        <relationshipName>Recurring_Gift_Commitments</relationshipName>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>fpnpc_analytics__Date_Established__c</fullName>
        <deprecated>false</deprecated>
        <description>Date the recurring donation was established. For automatic commitments = date of the first gift transaction. For manual (Identified) commitments = the promise date (EffectiveStartDate). Auto-populated by DonorStatsCalculator.</description>
        <inlineHelpText>Date the recurring donation was established (first gift transaction, or promise date for manually identified commitments).</inlineHelpText>
        <label>Date Established</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Date</type>
    </fields>
    <fields>
        <fullName>fpnpc_analytics__Duration__c</fullName>
        <deprecated>false</deprecated>
        <description>Number of whole months the recurring donation has been running, measured from Date Established to Last Donation Date (or today if still Active). Auto-populated by DonorStatsCalculator.</description>
        <externalId>false</externalId>
        <inlineHelpText>Duration of the recurring donation in whole months.</inlineHelpText>
        <label>Duration</label>
        <precision>9</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>fpnpc_analytics__End_Date__c</fullName>
        <deprecated>false</deprecated>
        <description>End date of the recurring sequence = date of the last assigned gift transaction, populated ONLY while RD Status = Lapsed. Empty for Active, Identified and Failed to Start commitments (the last transaction date is always available in Last Donation Date). Auto-populated by DonorStatsCalculator.</description>
        <inlineHelpText>Automatically populated from the most recent gift transaction linked to this commitment.</inlineHelpText>
        <label>End Date</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Date</type>
    </fields>
    <fields>
        <fullName>fpnpc_analytics__Last_Donation_Date__c</fullName>
        <deprecated>false</deprecated>
        <description>Date of the most recent gift transaction assigned to this commitment. Auto-populated by DonorStatsCalculator.</description>
        <inlineHelpText>Date of the most recent gift transaction linked to this commitment.</inlineHelpText>
        <label>Last Donation Date</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Date</type>
    </fields>
    <fields>
        <fullName>fpnpc_analytics__One_Year_Value__c</fullName>
        <deprecated>false</deprecated>
        <description>Projected annual value of the recurring donation = Amount multiplied by the estimated number of installments per year (derived from the median gap between gift transactions). Auto-populated by DonorStatsCalculator.</description>
        <inlineHelpText>Projected value of this recurring donation over one year.</inlineHelpText>
        <label>1 Year Value</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>fpnpc_analytics__RD_Status__c</fullName>
        <deprecated>false</deprecated>
        <label>RD Status</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Identified</fullName>
                    <default>false</default>
                    <label>Identified</label>
                </value>
                <value>
                    <fullName>Failed to Start</fullName>
                    <default>false</default>
                    <label>Failed to Start</label>
                </value>
                <value>
                    <fullName>Active</fullName>
                    <default>false</default>
                    <label>Active</label>
                </value>
                <value>
                    <fullName>Lapsed</fullName>
                    <default>false</default>
                    <label>Lapsed</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>fpnpc_analytics__Start_Date__c</fullName>
        <deprecated>false</deprecated>
        <description>Date of the first gift transaction assigned to this commitment. Auto-populated by DonorStatsCalculator.</description>
        <inlineHelpText>Automatically populated from the earliest gift transaction linked to this commitment.</inlineHelpText>
        <label>Start Date</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Date</type>
    </fields>
    <fields>
        <fullName>fpnpc_analytics__Total_Donations_Count__c</fullName>
        <deprecated>false</deprecated>
        <description>Number of gift transactions assigned to this commitment. Auto-populated by DonorStatsCalculator.</description>
        <externalId>false</externalId>
        <inlineHelpText>Number of gift transactions linked to this commitment.</inlineHelpText>
        <label>Total Donations Count</label>
        <precision>9</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>fpnpc_analytics__Total_Paid_Amount__c</fullName>
        <deprecated>false</deprecated>
        <description>Sum of all gift transaction amounts assigned to this commitment, converted to the donor currency. Auto-populated synchronously by DonorStatsCalculator (unlike the read-only asynchronous standard rollup TotalPaidTransactionAmount).</description>
        <inlineHelpText>Total amount paid across all gift transactions on this commitment.</inlineHelpText>
        <label>Total Paid Amount</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <type>Currency</type>
    </fields>
