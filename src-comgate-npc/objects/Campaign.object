    <fields>
        <fullName>fpnpc_analytics__One_Off_Average_Amount__c</fullName>
        <deprecated>false</deprecated>
        <description>Average amount per One-Off donation in this campaign (Total Donations Amount One-Off / Total Donations Count One-Off). Campaign scope only.</description>
        <formula>IF(fpnpc_analytics__Total_Donations_Count_One_Off__c &gt; 0, fpnpc_analytics__Total_Donations_Amount_One_Off__c / fpnpc_analytics__Total_Donations_Count_One_Off__c, NULL)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>One-Off Average Amount</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>fpnpc_analytics__One_Off_Donor_Average_Amount__c</fullName>
        <deprecated>false</deprecated>
        <description>Average One-Off donation amount per distinct donor in this campaign (Total Donations Amount One-Off / Total Donors One-Off). Campaign scope only.</description>
        <formula>IF(fpnpc_analytics__Total_Donors_One_Off__c &gt; 0, fpnpc_analytics__Total_Donations_Amount_One_Off__c / fpnpc_analytics__Total_Donors_One_Off__c, NULL)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>One-Off Donor Average Amount</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>fpnpc_analytics__Regular_Average_Amount__c</fullName>
        <deprecated>false</deprecated>
        <description>Average amount per Regular (Gift Commitment installment) donation in this campaign (Total Donations Amount Regular / Total Donations Count Regular). Campaign scope only.</description>
        <formula>IF(fpnpc_analytics__Total_Donations_Count_Regular__c &gt; 0, fpnpc_analytics__Total_Donations_Amount_Regular__c / fpnpc_analytics__Total_Donations_Count_Regular__c, NULL)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Regular Average Amount</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>fpnpc_analytics__Regular_Donor_Average_Amount__c</fullName>
        <deprecated>false</deprecated>
        <description>Average Regular donation amount per distinct donor in this campaign (Total Donations Amount Regular / Total Donors Regular). Campaign scope only.</description>
        <formula>IF(fpnpc_analytics__Total_Donors_Regular__c &gt; 0, fpnpc_analytics__Total_Donations_Amount_Regular__c / fpnpc_analytics__Total_Donors_Regular__c, NULL)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Regular Donor Average Amount</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <type>Currency</type>
    </fields>
