    <fields>
        <fullName>CRMforNonProfit__Account_Num__c</fullName>
        <deprecated>false</deprecated>
        <externalId>false</externalId>
        <label>Account Num.</label>
        <length>255</length>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>CRMforNonProfit__Average_Donation__c</fullName>
        <deprecated>false</deprecated>
        <formula>CRMforNonProfit__celkova_hodnota_finacni_dary__c / CRMforNonProfit__pocet_financnich_daru__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Average Donation</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>CRMforNonProfit__DniMeziDary__c</fullName>
        <deprecated>false</deprecated>
        <externalId>false</externalId>
        <formula>IF(   CRMforNonProfit__pocet_financnich_daru__c &gt; 0, ( DATEVALUE(  CRMforNonProfit__datum_posledniho_financniho_daru__c ) -  CRMforNonProfit__First_Transaction_Date__c ) / CRMforNonProfit__pocet_financnich_daru__c , 0)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Počet dní mezi dary</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>CRMforNonProfit__DniOdPoslednihoDaru__c</fullName>
        <deprecated>false</deprecated>
        <externalId>false</externalId>
        <formula>TODAY() - DATEVALUE(  CRMforNonProfit__datum_posledniho_financniho_daru__c )</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Počet dní od posledního daru</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <type>Number</type>
        <unique>false</unique>
    </fields>
