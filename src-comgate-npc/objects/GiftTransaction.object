    <fields>
        <fullName>Receipt_Donor_Address__c</fullName>
        <description>Adresa darce na potvrzeni o daru (osoba: korespondencni, firma: fakturacni).</description>
        <externalId>false</externalId>
        <formula>IF(Donor.IsPersonAccount, TRIM(BLANKVALUE(Donor.PersonMailingStreet, &quot;&quot;) &amp; &quot;, &quot; &amp; BLANKVALUE(Donor.PersonMailingPostalCode, &quot;&quot;) &amp; &quot; &quot; &amp; BLANKVALUE(Donor.PersonMailingCity, &quot;&quot;)), TRIM(BLANKVALUE(Donor.BillingStreet, &quot;&quot;) &amp; &quot;, &quot; &amp; BLANKVALUE(Donor.BillingPostalCode, &quot;&quot;) &amp; &quot; &quot; &amp; BLANKVALUE(Donor.BillingCity, &quot;&quot;)))</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Potvrzení – adresa dárce</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Receipt_Donor_Email__c</fullName>
        <description>E-mail darce na potvrzeni o daru (osoba: PersonEmail, firma: e-mail primarniho kontaktu).</description>
        <externalId>false</externalId>
        <formula>IF(Donor.IsPersonAccount, Donor.PersonEmail, Donor.npc_bridge__PrimaryContact__r.Email)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Potvrzení – e-mail dárce</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Receipt_Donor_Name__c</fullName>
        <description>Jmeno darce na potvrzeni o daru.</description>
        <externalId>false</externalId>
        <formula>IF(Donor.IsPersonAccount, TRIM(BLANKVALUE(Donor.FirstName, &quot;&quot;) &amp; &quot; &quot; &amp; BLANKVALUE(Donor.LastName, &quot;&quot;)), Donor.Name)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Potvrzení – jméno dárce</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
