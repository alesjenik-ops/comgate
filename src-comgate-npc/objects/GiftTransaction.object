        <fullName>Finance_Material__c</fullName>
        <description>Rozlišení finančního a materiálního daru. Rekonstruováno pro cílový org - v případě potřeby upravte formuli podle zdrojového orgu.</description>
        <externalId>false</externalId>
        <formula>IF( ISPICKVAL( GiftType , &quot;InKind&quot; ), &quot;Materiální&quot;, &quot;Finanční&quot;)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Finance / Materiál</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
