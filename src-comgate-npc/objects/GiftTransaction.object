    <fields>
        <fullName>npc_ext__Donation_Receipt__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <deprecated>false</deprecated>
        <inlineHelpText>Platné potvrzení, ve kterém je tento dar zahrnutý. Vyplňuje aplikace při vystavení potvrzení.</inlineHelpText>
        <label>Potvrzení o daru</label>
        <referenceTo>npc_ext__Donation_Receipt__c</referenceTo>
        <relationshipLabel>Dary</relationshipLabel>
        <relationshipName>Gifts</relationshipName>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>npc_ext__Gift_Type_Text__c</fullName>
        <deprecated>false</deprecated>
        <description>Czech text of the system picklist GiftType, which cannot be translated</description>
        <externalId>false</externalId>
        <formula>CASE(TEXT(GiftType), &quot;Individual&quot;, &quot;Jednotlivec&quot;, &quot;Organizational&quot;, &quot;Organizace/domácnost&quot;, TEXT(GiftType))</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <inlineHelpText>Dar od jednotlivce, nebo od organizace či domácnosti.</inlineHelpText>
        <label>Typ daru</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>npc_ext__Receipt_Info__c</fullName>
        <deprecated>false</deprecated>
        <externalId>false</externalId>
        <formula>IF(ISPICKVAL(TaxReceiptStatus, &quot;Don&apos;t Send&quot;), &quot;Neposílat&quot;,
IF(NOT(ISBLANK(npc_ext__Donation_Receipt__c)),
   CASE(npc_ext__Donation_Receipt__r.npc_ext__Type__c, &quot;Single&quot;, &quot;Jednotlivé &quot;, &quot;Interim&quot;, &quot;Průběžné &quot;, &quot;Annual&quot;, &quot;Roční &quot;, &quot;&quot;) &amp; npc_ext__Donation_Receipt__r.Name
   &amp; &quot; · &quot; &amp; CASE(npc_ext__Donation_Receipt__r.npc_ext__Status__c, &quot;Ready&quot;, &quot;připraveno&quot;, &quot;Sent&quot;, &quot;odesláno&quot;, &quot;PDF_Only&quot;, &quot;PDF&quot;, &quot;Error&quot;, &quot;chyba&quot;, &quot;Replaced&quot;, &quot;nahrazeno&quot;, &quot;Cancelled&quot;, &quot;zrušeno&quot;, TEXT(npc_ext__Donation_Receipt__r.npc_ext__Status__c)),
IF(NOT(ISBLANK(GiftCommitmentId)), &quot;Čeká na roční potvrzení&quot;, &quot;Bez potvrzení&quot;)))</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <inlineHelpText>Jednotlivé/Průběžné/Roční + číslo potvrzení a jeho stav; u pravidelného daru bez potvrzení „Čeká na roční potvrzení“.</inlineHelpText>
        <label>Stav potvrzení</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>npc_ext__Receipt_Recipient__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <deprecated>false</deprecated>
        <inlineHelpText>Vyplňte jen výjimečně, když má potvrzení za tento dar dostat někdo jiný než dárce.</inlineHelpText>
        <label>Příjemce potvrzení</label>
        <referenceTo>Account</referenceTo>
        <relationshipLabel>Dary s potvrzením na tento subjekt</relationshipLabel>
        <relationshipName>Receipt_Gifts</relationshipName>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Lookup</type>
    </fields>
