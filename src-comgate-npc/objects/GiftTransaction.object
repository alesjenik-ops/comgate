    <fields>
        <fullName>Status__c</fullName>
        <label>Donation Status</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>CAPTURED</fullName>
                    <default>false</default>
                    <label>CAPTURED</label>
                </value>
                <value>
                    <fullName>PENDING</fullName>
                    <default>false</default>
                    <label>PENDING</label>
                </value>
                <value>
                    <fullName>ERROR</fullName>
                    <default>false</default>
                    <label>ERROR</label>
                </value>
                <value>
                    <fullName>CHARGEBACK</fullName>
                    <default>false</default>
                    <label>CHARGEBACK</label>
                </value>
                <value>
                    <fullName>CANCELLATION</fullName>
                    <default>false</default>
                    <label>CANCELLATION</label>
                </value>
                <value>
                    <fullName>REFUND</fullName>
                    <default>false</default>
                    <label>REFUND</label>
                </value>
                <value>
                    <fullName>PAID</fullName>
                    <default>false</default>
                    <label>PAID</label>
                </value>
                <value>
                    <fullName>AUTHORIZED</fullName>
                    <default>false</default>
                    <label>AUTHORIZED</label>
                </value>
                <value>
                    <fullName>CANCELLED</fullName>
                    <default>false</default>
                    <label>CANCELLED</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>TaxDeductionAmount</fullName>
    </fields>
    <fields>
        <fullName>TaxReceiptStatus</fullName>
        <trackHistory>false</trackHistory>
        <type>Picklist</type>
    </fields>
    <fields>
        <fullName>Thank_You_Amount__c</fullName>
        <description>Castka daru jako text s mezerou po tisicich (1 500), pro e-mail a potvrzeni.</description>
        <externalId>false</externalId>
        <formula>IF(OriginalAmount &gt;= 1000, TEXT(FLOOR(OriginalAmount / 1000)) &amp; &quot; &quot; &amp; RIGHT(&quot;000&quot; &amp; TEXT(FLOOR(OriginalAmount) - FLOOR(OriginalAmount / 1000) * 1000), 3), TEXT(FLOOR(OriginalAmount)))</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Částka daru (text)</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Thank_You_Donor_Name__c</fullName>
        <description>Osloveni pro dekovny e-mail: vokativ darce, jinak jmeno a prijmeni, u firmy nazev.</description>
        <externalId>false</externalId>
        <formula>IF(NOT(ISBLANK(Donor.CRMforNonProfit__Vocative__pc)), Donor.CRMforNonProfit__Vocative__pc, IF(Donor.IsPersonAccount, TRIM(BLANKVALUE(Donor.FirstName, &quot;&quot;) &amp; &quot; &quot; &amp; BLANKVALUE(Donor.LastName, &quot;&quot;)), Donor.Name))</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Oslovení pro poděkování</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Thank_You_Email_Sent__c</fullName>
        <defaultValue>false</defaultValue>
        <label>Thank You Email Sent</label>
        <trackHistory>false</trackHistory>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>TotalTransactionFee</fullName>
    </fields>
    <fields>
        <fullName>TransactionDate</fullName>
        <trackHistory>false</trackHistory>
    </fields>
    <fields>
        <fullName>TransactionDueDate</fullName>
        <trackHistory>false</trackHistory>
    </fields>
    <fields>
        <fullName>Transaction_Year__c</fullName>
        <description>Rok prijeti daru pro nadpis potvrzeni o daru.</description>
        <externalId>false</externalId>
        <formula>TEXT(YEAR(TransactionDate))</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Rok daru</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Upominka_1_odeslana__c</fullName>
        <description>Datum odeslání 1. automatické upomínky nezaplaceného daru (10. den). Plní Flow Upominky_nezaplacenych_daru.</description>
        <inlineHelpText>Kdy odešla 1. upomínka (10. den).</inlineHelpText>
        <label>Upomínka 1 odeslána</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Date</type>
    </fields>
    <fields>
        <fullName>Upominka_2_odeslana__c</fullName>
        <description>Datum odeslání 2. automatické upomínky nezaplaceného daru (21. den). Plní Flow Upominky_nezaplacenych_daru.</description>
        <inlineHelpText>Kdy odešla 2. upomínka (21. den).</inlineHelpText>
        <label>Upomínka 2 odeslána</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Date</type>
    </fields>
    <fields>
        <fullName>fpnpc_analytics__Darujme_Transaction__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <deprecated>false</deprecated>
        <description>Lookup to the Darujme Transaction this gift originates from. Populated by the Darujme integration when the gift transaction is created. Donor analytics propagates the parent Darujme Pledge from here to GiftCommitment.Darujme_Pledge__c.</description>
        <inlineHelpText>The Darujme transaction this gift originates from.</inlineHelpText>
        <label>Darujme Transaction</label>
        <referenceTo>CRMforNonProfit__Darujme_Transaction__c</referenceTo>
        <relationshipLabel>Gift Transactions</relationshipLabel>
        <relationshipName>Gift_Transactions</relationshipName>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>fpnpc_analytics__Gift_Agreement__c</fullName>
        <defaultValue>false</defaultValue>
        <deprecated>false</deprecated>
        <description>Checked when a signed gift agreement exists for this gift. Many in-kind gifts have none; annual reports split volumes and counts by this flag.</description>
        <inlineHelpText>Zaškrtněte, pokud k daru existuje darovací smlouva.</inlineHelpText>
        <label>Gift Agreement</label>
        <trackHistory>false</trackHistory>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>fpnpc_analytics__Gift_Commitment__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <deprecated>false</deprecated>
        <description>Analytics-managed link to the recurring GiftCommitment. NPC forbids editing the standard GiftCommitmentId field once a transaction is Paid, so GiftCommitmentAssignmentBatch writes the cluster assignment here instead. Analytics reads this field first and falls back to the standard GiftCommitmentId (NPC-managed links).</description>
        <inlineHelpText>Recurring gift commitment assigned by donor analytics. Managed automatically; do not edit.</inlineHelpText>
        <label>Gift Commitment (Analytics)</label>
        <referenceTo>GiftCommitment</referenceTo>
        <relationshipLabel>Gift Transactions (Analytics)</relationshipLabel>
        <relationshipName>Analytics_Gift_Transactions</relationshipName>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>fpnpc_analytics__One_Off_Regular__c</fullName>
        <deprecated>false</deprecated>
        <description>Ported from fpack CRMforNonProfit__Transaction__c formula (label &quot;Frekvence&quot;). Classifies the transaction as Regular when it is linked to a recurring GiftCommitment, otherwise One-Off. Uses the effective link: the analytics lookup Gift_Commitment__c first, falling back to the standard GiftCommitmentId (NPC-managed and insert-time links).</description>
        <externalId>false</externalId>
        <formula>IF( AND( ISBLANK( fpnpc_analytics__Gift_Commitment__c ), ISBLANK( GiftCommitmentId ) ), &quot;One-Off&quot;, &quot;Regular&quot; )</formula>
        <inlineHelpText>Regular = the gift belongs to a recurring gift commitment; One-Off = a standalone gift.</inlineHelpText>
        <label>Frequency</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>fpnpc_analytics__Organization__c</fullName>
        <deprecated>false</deprecated>
        <description>Which brand/organization the gift belongs to. Organization 1 and Organization 2 are generic placeholder values – each org relabels them or adds its own organizations in Setup. Set by the integration or manually when the gift is created; used by annual-report analytics.</description>
        <inlineHelpText>Značka/organizace, které dar patří.</inlineHelpText>
        <label>Organization</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>NSK</fullName>
                    <default>false</default>
                    <label>NSK</label>
                </value>
                <value>
                    <fullName>Smajlicek</fullName>
                    <default>false</default>
                    <label>Smajlíček</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>npc_bridge__Bank_Account_Name__c</fullName>
        <deprecated>false</deprecated>
        <externalId>false</externalId>
        <label>Bank Account Name</label>
        <length>255</length>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>npc_bridge__Darujme_Transaction__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <deprecated>false</deprecated>
        <label>Darujme Transaction</label>
