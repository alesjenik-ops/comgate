<?xml version="1.0" encoding="UTF-8"?>
<Report xmlns="http://soap.sforce.com/2006/04/metadata">
    <columns>
        <field>GiftTransaction$Name</field>
    </columns>
    <columns>
        <aggregateTypes>Sum</aggregateTypes>
        <field>GiftTransaction$OriginalAmount</field>
    </columns>
    <description>Zaplacené finanční dary po letech a podle způsobu platby. Finanční dar je definován whitelistem Gift_Type_Settings__mdt (Financial Donations), ne negací In-Kind — ta propouští i dary s nevyplněným způsobem platby. Nový způsob platby doplňte i do filtru.</description>
    <filter>
        <criteriaItems>
            <column>GiftTransaction$Status</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>equals</operator>
            <value>Paid</value>
        </criteriaItems>
        <criteriaItems>
            <column>GiftTransaction$PaymentMethod</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>equals</operator>
            <value>ACH,Asset,Cash,Check,Credit Card,Cryptocurrency,PayPal,Stock,Unknown,Venmo</value>
        </criteriaItems>
        <language>en_US</language>
    </filter>
    <format>Summary</format>
    <groupingsDown>
        <dateGranularity>Year</dateGranularity>
        <field>GiftTransaction$TransactionDate</field>
        <sortOrder>Asc</sortOrder>
    </groupingsDown>
    <groupingsDown>
        <dateGranularity>Day</dateGranularity>
        <field>GiftTransaction$PaymentMethod</field>
        <sortOrder>Asc</sortOrder>
    </groupingsDown>
    <name>Finanční dary (objem a počet)</name>
    <params>
        <name>co</name>
        <value>1</value>
    </params>
    <reportType>Gift_Transactions_NPC__c</reportType>
    <scope>organization</scope>
    <showDetails>false</showDetails>
    <showGrandTotal>true</showGrandTotal>
    <showSubTotals>true</showSubTotals>
    <timeFrameFilter>
        <dateColumn>GiftTransaction$TransactionDate</dateColumn>
        <interval>INTERVAL_CUSTOM</interval>
    </timeFrameFilter>
</Report>
