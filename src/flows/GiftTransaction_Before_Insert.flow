<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>64.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Set_Campaign</name>
        <label>Set Campaign</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>$Record.CampaignId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Campaign.Id</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>Set_GiftTransaction_Default</name>
        <label>Set GiftTransaction Default</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>$Record.Name</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>name</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Unicredit_Check</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Campaign_Check</name>
        <label>Campaign Check</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Campaign_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Campaign</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Campaign</targetReference>
            </connector>
            <label>Campaign Found</label>
        </rules>
    </decisions>
    <decisions>
        <name>Unicredit_Check</name>
        <label>Unicredit Check</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Unicredit</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.PaymentMethod</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Bankovní převod</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Campaign</targetReference>
            </connector>
            <label>Unicredit</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>name</name>
        <dataType>String</dataType>
        <expression>IF(
  NOT(ISBLANK({!$Record.GiftCommitmentId})),
  &apos;Pravidelný Dar - &apos;,
  &apos;Jednorázový Dar - &apos;
)
&amp; {!$Record.Donor.Firstname}
&amp; &apos; &apos;
&amp; {!$Record.Donor.Lastname}
&amp; &apos; - &apos;
&amp; TEXT({!$Record.OriginalAmount})
&amp; &apos; CZK - &apos;
&amp; TEXT({!$Record.TransactionDueDate})</expression>
    </formulas>
    <formulas>
        <name>variable</name>
        <dataType>Number</dataType>
        <expression>VALUE({!$Record.npc_bridge__Variable_Symbol__c})</expression>
        <scale>0</scale>
    </formulas>
    <interviewLabel>GiftTransaction Before Insert {!$Flow.CurrentDateTime}</interviewLabel>
    <label>GiftTransaction Before Insert</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Campaign</name>
        <label>Get Campaign</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Campaign_Check</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>CRMforNonProfit__Variable_No__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>variable</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Campaign</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Set_GiftTransaction_Default</targetReference>
        </connector>
        <object>GiftTransaction</object>
        <recordTriggerType>Create</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
