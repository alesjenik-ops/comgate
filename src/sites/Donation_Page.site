    <redirectToCustomDomain>false</redirectToCustomDomain>
    <referrerPolicyOriginWhenCrossOrigin>true</referrerPolicyOriginWhenCrossOrigin>
    <selfRegPage>CommunitiesSelfReg</selfRegPage>
    <serverIsDown>SNA_I1LFm_sf_default_cdn_Donation_Page1</serverIsDown>
    <siteAdmin>cervenykriz@crmproneziskovky.cz</siteAdmin>
    <siteGuestRecordDefaultOwner>cervenykriz@crmproneziskovky.cz</siteGuestRecordDefaultOwner>
    <siteType>ChatterNetwork</siteType>
    <urlPathPrefix>donation</urlPathPrefix>
