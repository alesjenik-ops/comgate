    <listViews>
        <fullName>All_GiftTransactions</fullName>
        <columns>Name</columns>
        <columns>Donor</columns>
        <columns>CurrentAmount</columns>
        <columns>TransactionDueDate</columns>
        <columns>CreatedDate</columns>
        <columns>Status</columns>
        <columns>npc_bridge__Target_Account_Number__c</columns>
        <filterScope>Everything</filterScope>
        <filters>
            <field>TransactionDate</field>
            <operation>greaterOrEqual</operation>
            <value>1/1/2026</value>
        </filters>
        <label>Všechny Transakce</label>
    </listViews>
