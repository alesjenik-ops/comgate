<aura:component description="DonationPageFormFieldSet">
    <aura:attribute name="fieldSetWrapper" type="Map"/>
    <aura:attribute name="record" type="SObject"/>
    <aura:method name="validate"/>
    
    <aura:iteration items="{!v.fieldSetWrapper}" var="item">
        <c:DonationPageFormFieldSetItem item="{!item}"
                                        record="{!v.record}"
                                        aura:id="cmpValidate"/>

    </aura:iteration>
</aura:component>